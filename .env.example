# Copy to .env at repository root. Never commit real values.
DJANGO_SECRET_KEY=replace-with-a-random-secret-at-least-50-characters-long
DJANGO_DEBUG=false
POSTGRES_DB=netsentinel
POSTGRES_USER=netsentinel
POSTGRES_PASSWORD=replace-with-your-local-database-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_SSLMODE=prefer
# Separate random tokens, 32..256 printable non-space ASCII characters each.
# Never reuse these or publish them in browser bundles. See docs/LOCAL_AUTH.md.
NETSENTINEL_READ_TOKEN=replace-with-random-read-token
NETSENTINEL_INGEST_TOKEN=replace-with-random-ingestion-token
NETSENTINEL_MODEL_TOKEN=replace-with-random-model-publication-token
