# Server-only Django API root. Do not use NEXT_PUBLIC_ or include credentials.
BACKEND_API_BASE_URL=http://127.0.0.1:8001/api/v1/
# Server-only. Read token must match root .env; operator password must differ.
NETSENTINEL_READ_TOKEN=replace-with-random-read-token
NETSENTINEL_OPERATOR_PASSWORD=replace-with-random-local-operator-password
