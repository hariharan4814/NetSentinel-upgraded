    "framer-motion": "^13.2.0",
    "jspdf": "4.2.1",
    "jspdf-autotable": "5.0.8",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "tsx": "4.23.13",
    "typescript": "5.9.3"
  }
