{
  "name": "netsentinel-dashboard",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "build:public": "node scripts/build-public.mjs",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint . --max-warnings 0",
